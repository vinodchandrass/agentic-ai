   Ren, Xiaotian; Tang, Xiaojin, SINOPEC Res Inst Petr Proc Co Ltd, Beijing 100083, Peoples R China.},
DOI = {10.1021/acscatal.5c06431},
EarlyAccessDate = {OCT 2025},
ISSN = {2155-5435},
Keywords = {large language models; automated literature mining; catalyst discovery;
   materials informatics; artificial intelligence},
