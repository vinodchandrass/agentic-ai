@article{ WOS:001572784200001,
Author = {Kobis, Nils and Rahwan, Zoe and Rilla, Raluca and Supriyatno, Bramantyo
   Ibrahim and Bersch, Clara and Ajaj, Tamer and Bonnefon, Jean-Francois
   and Rahwan, Iyad},
Title = {Delegation to artificial intelligence can increase dishonest behaviour},
Journal = {NATURE},
Year = {2025},
Volume = {646},
Number = {8083},
Month = {OCT 2},
Abstract = {Although artificial intelligence enables productivity gains from
   delegating tasks to machines1, it may facilitate the delegation of
   unethical behaviour2. This risk is highly relevant amid the rapid rise
   of `agentic' artificial intelligence systems3,4. Here we demonstrate
   this risk by having human principals instruct machine agents to perform
   tasks with incentives to cheat. Requests for cheating increased when
   principals could induce machine dishonesty without telling the machine
   precisely what to do, through supervised learning or high-level goal
   setting. These effects held whether delegation was voluntary or
   mandatory. We also examined delegation via natural language to large
   language models5. Although the cheating requests by principals were not
   always higher for machine agents than for human agents, compliance
   diverged sharply: machines were far more likely than human agents to
   carry out fully unethical instructions. This compliance could be curbed,
   but usually not eliminated, with the injection of prohibitive,
   task-specific guardrails. Our results highlight ethical risks in the
   context of increasingly accessible and powerful machine delegation, and
   suggest design and policy strategies to mitigate them.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {Köbis, N (Corresponding Author), Univ Duisburg Essen, Res Ctr Trustworthy Data Sci \& Secur, Duisburg, Germany.
   Köbis, N; Rahwan, I (Corresponding Author), Max Planck Inst Human Dev, Ctr Humans \& Machines, Berlin, Germany.
   Rahwan, Z (Corresponding Author), Max Planck Inst Human Dev, Ctr Adapt Rat, Berlin, Germany.
   Bonnefon, JF (Corresponding Author), Univers Toulouse Capitole, Toulouse Sch Econ, CNRS TSM R, Toulouse, France.
   Kobis, Nils, Univ Duisburg Essen, Res Ctr Trustworthy Data Sci \& Secur, Duisburg, Germany.
