@article{ WOS:001612739400002,
Author = {Zhang, Di and Li, Mingchen and Wang, Zhe},
Title = {PV-GPT: query the PV data using natural language},
Journal = {JOURNAL OF BUILDING ENGINEERING},
Year = {2025},
Volume = {115},
Month = {DEC 1},
Abstract = {Building operations account for about 30 \% of global final energy use,
   underscoring the need for intelligent, data-driven energy management.
   Modern building automation systems generate vast volumes of real-time
   time-series data from heterogeneous sources, yet non-technical users
   often face high entry barriers due to fragmented metadata, inconsistent
   APIs, and complex query languages. To address these challenges, we
   present PV-GPT, an agent framework that leverages large language models
   (LLMs) and the Brick ontology to enable natural language querying of
   building energy data. By integrating structured prompting, modular
   primitive functions, and a closed-loop retrieval-generation-execution
   architecture, PV-GPT translates user queries into accurate, executable
   code across semantic (SPARQL), API, and time-series databases. The
   system is evaluated using a real-world dataset collected from 60 rooftop
   photovoltaic (PV) systems at the Hong Kong University of Science and
   Technology, accessed via the SolarEdge API. Additionally, we construct a
   synthetic question-answering dataset comprising over 1000 diverse
   temporal and semantic query tasks for performance testing. Typical
   end-to-end response time ranges from 2 to 6 s, corresponding to
   human-computer interactivity rather than hard real-time control, with
   latency primarily arising from LLM inference and external API response
   delays. Experimental results show that PV-GPT achieves a task-solving
   accuracy of 98.14 \%, significantly outperforming baseline prompting
   approaches. The system consistently generates syntactically correct,
   executable Python scripts aligned with real-world data schemas,
   demonstrating strong generalizability and operational reliability. This
   work contributes: (1) a novel LLM-agent framework tailored to real-time
   building data access; (2) a structured prompting method integrating
   semantic models and code primitives; (3) and a validated QA dataset
   supporting systematic evaluation. These results illustrate the potential
   of LLM-driven agents to democratize building analytics, reduce
   dependence on manual scripting, and support scalable, real-time
   decision-making in smart building environments. The demo video of PV-GPT
   can be viewed at https://youtu.be/iEYb6x8OcnQ.},
